{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.kt_runtime.native_shake": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "shaking": "q.has_tag('kaleidoscope_tavern:holding_shaker') && q.is_item_name_any('slot.weapon.mainhand', 0, 'kaleidoscope_tavern:shaker')"
            }
          ]
        },
        "shaking": {
          "animations": [
            {
              "shake_first": "c.is_first_person"
            }
          ],
          "blend_transition": 0.06,
          "transitions": [
            {
              "idle": "!(q.has_tag('kaleidoscope_tavern:holding_shaker') && q.is_item_name_any('slot.weapon.mainhand', 0, 'kaleidoscope_tavern:shaker'))"
            }
          ]
        }
      }
    }
  }
}
